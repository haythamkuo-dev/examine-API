{
  "name": "examine_api",
  "type": "module",
  "module": "index.ts",
  "main": "./dist/index.js",
  "bin": {
    "examine-api": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build index.ts --outdir dist --format esm --target node --minify",
    "build:api": "bun build src/server/index.ts --outdir dist/server --format esm --target bun",
    "build:web": "vite build",
    "start:api": "bun run dist/server/index.js",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:api": "bun test --preload ./tests/setup.ts ./src/server",
    "test:web": "bun test --preload ./tests/web-setup.ts ./web",
    "dev:api": "bun --hot run src/server/index.ts",
    "dev:web": "vite",
    "deposit": "bun run index.ts deposit create",
    "payout": "bun run index.ts payout create",
    "subscribe": "bun run index.ts subscription create",
    "preview:deposit": "bun run index.ts deposit preview",
    "preview:payout": "bun run index.ts payout preview",
    "preview:subscription": "bun run index.ts subscription preview",
    "structure": "tree -a -L 4 -I 'node_modules|dist|design-system|.git|.claude|.github|.codex|.DS_Store|.gitignore|.gitnexus' > structure.md"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.1.11"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "commander": "^14.0.3",
    "ora": "^9.4.0",
    "picocolors": "^1.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.15.0"
  }
}
