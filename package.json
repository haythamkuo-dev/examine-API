{
  "name": "examine_api",
  "type": "module",
  "scripts": {
    "build:api": "bun build src/server/index.ts --outdir dist/server --format esm --target bun",
    "build:web": "vite build",
    "start:api": "bun run dist/server/index.js",
    "test": "bun run test:api && bun run test:web",
    "test:api": "bun test --isolate --preload ./tests/setup.ts ./src tests/formValidation.test.ts",
    "test:web": "bun test --isolate --preload ./tests/web-setup.ts ./web",
    "test:db": "bun test --isolate --preload ./tests/integration-setup.ts ./src/core/database.integration.test.ts",
    "db:migrate": "bun run scripts/database.ts migrate",
    "db:integration:reset": "bun run scripts/database.ts integration-reset",
    "db:integration:provision": "bun run scripts/database.ts integration-provision",
    "db:integration:teardown": "bun run scripts/database.ts integration-teardown",
    "dev:api": "bun --hot run src/server/index.ts",
    "dev:web": "vite",
    "structure": "tree -a -L 4 -I 'node_modules|dist|design-system|.git|.claude|.github|.codex|.DS_Store|.gitignore' > structure.md"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.1.11"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "ora": "^9.4.0",
    "picocolors": "^1.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.15.0",
    "react-toastify": "^11.1.0"
  }
}
